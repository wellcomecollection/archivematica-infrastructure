#!/usr/bin/env bash
# This script starts an SSM session on the Archivematica ECS container host.
#
# == Usage ==
#
#       ssh_to_archivematica <prod|staging>
#
# == Prerequisites ==
#
#   *   You have AWS credentials for the workflow account
#   *   You have the AWS CLI and Session Manager plugin installed
#

set -o errexit
set -o nounset

ENVIRONMENT="${1:-}"
AWS_REGION="eu-west-1"
WORKFLOW_ACCOUNT_ID="299497370133"

if [[ "${ENVIRONMENT:-}" != "prod" && "${ENVIRONMENT:-}" != "staging" ]]
then
  echo "Usage: ssh_to_archivematica <prod|staging>" >&2
  exit 1
fi

if ! command -v aws >/dev/null
then
  echo "The AWS CLI is required." >&2
  exit 1
fi

if ! command -v session-manager-plugin >/dev/null
then
  echo "The AWS Session Manager plugin is required." >&2
  exit 1
fi

if ! CALLER_ACCOUNT_ID=$(
  aws sts get-caller-identity \
    --region "$AWS_REGION" \
    --query Account \
    --output text
)
then
  echo "Unable to authenticate with the selected AWS credentials." >&2
  echo "An SSO login does not select a profile for subsequent commands." >&2
  echo "Set AWS_PROFILE, for example:" >&2
  echo "  env AWS_PROFILE=workflow-developer $0 $ENVIRONMENT" >&2
  exit 1
fi

if [[ "$CALLER_ACCOUNT_ID" != "$WORKFLOW_ACCOUNT_ID" ]]
then
  echo "Expected workflow account $WORKFLOW_ACCOUNT_ID, authenticated to $CALLER_ACCOUNT_ID." >&2
  echo "Select appropriate AWS credentials, for example with AWS_PROFILE." >&2
  exit 1
fi

CLUSTER_NAME="archivematica-$ENVIRONMENT"

CONTAINER_INSTANCE_ARN=$(
  aws ecs list-container-instances \
    --region "$AWS_REGION" \
    --cluster "$CLUSTER_NAME" \
    --status ACTIVE \
    --filter 'agentConnected == true' \
    --query 'containerInstanceArns[0]' \
    --output text
)

if [[ -z "$CONTAINER_INSTANCE_ARN" || "$CONTAINER_INSTANCE_ARN" == "None" ]]
then
  echo "No connected container instance found in $CLUSTER_NAME" >&2
  echo "The EC2 host may be stopped or its ECS agent may be disconnected." >&2
  exit 1
fi

EC2_INSTANCE_ID=$(
  aws ecs describe-container-instances \
    --region "$AWS_REGION" \
    --cluster "$CLUSTER_NAME" \
    --container-instances "$CONTAINER_INSTANCE_ARN" \
    --query 'containerInstances[0].ec2InstanceId' \
    --output text
)

if [[ -z "$EC2_INSTANCE_ID" || "$EC2_INSTANCE_ID" == "None" ]]
then
  echo "No connected EC2 instance found in $CLUSTER_NAME" >&2
  exit 1
fi

echo "Starting an SSM session on $EC2_INSTANCE_ID ($CLUSTER_NAME)"

exec aws ssm start-session \
  --region "$AWS_REGION" \
  --target "$EC2_INSTANCE_ID"
